<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="MiBiblioteca.gui.PrincipalController" styleClass="ventana">

    <fx:define>
        <ToggleGroup fx:id="grupoMenu"/>
    </fx:define>

    <left>
        <VBox styleClass="barra-lateral" prefWidth="220" spacing="6">
            <!-- Para usar tu imagen: reemplazá este Label por un ImageView con icono.png -->
            <Label text="🦫" styleClass="logo-capibara"/>

            <ToggleButton text="👥   Socios" userData="Socios.fxml"
                          toggleGroup="$grupoMenu" styleClass="boton-menu" maxWidth="Infinity"/>
            <ToggleButton text="📖   Catálogo" userData="Catalogo.fxml"
                          toggleGroup="$grupoMenu" styleClass="boton-menu" maxWidth="Infinity"/>
            <ToggleButton fx:id="botonPrestamos" text="📅   Préstamos" userData="Prestamos.fxml"
                          toggleGroup="$grupoMenu" styleClass="boton-menu" maxWidth="Infinity"/>
        </VBox>
    </left>

    <top>
        <VBox styleClass="encabezado" spacing="2">
            <Label text="Biblioteca Capibara" styleClass="titulo-aplicacion"/>
            <Label text="Leer hoy, un mejor mañana" styleClass="lema-aplicacion"/>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="contenedorDePantalla"/>
    </center>
</BorderPane>

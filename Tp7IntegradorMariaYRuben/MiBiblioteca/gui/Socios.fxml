<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="MiBiblioteca.gui.SociosController"
      styleClass="pantalla" spacing="18">
    <padding><Insets top="22" right="28" bottom="22" left="28"/></padding>

    <VBox spacing="2">
        <Label text="Socios" styleClass="titulo-pantalla"/>
        <Label text="Personas registradas en la biblioteca" styleClass="subtitulo-pantalla"/>
    </VBox>

    <VBox styleClass="tarjeta-tabla" VBox.vgrow="ALWAYS">
        <TableView fx:id="tablaSocios" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="columnaDni" text="D.N.I."/>
                <TableColumn fx:id="columnaNombre" text="NOMBRE"/>
                <TableColumn fx:id="columnaTipo" text="TIPO"/>
                <TableColumn fx:id="columnaLibrosEnPoder" text="LIBROS EN PODER"/>
                <TableColumn fx:id="columnaDiasDePrestamo" text="DÍAS DE PRÉSTAMO"/>
            </columns>
            <placeholder><Label text="No hay socios dados de alta."/></placeholder>
        </TableView>
    </VBox>
</VBox>

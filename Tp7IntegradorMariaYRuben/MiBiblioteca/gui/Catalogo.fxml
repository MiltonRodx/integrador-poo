<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="MiBiblioteca.gui.CatalogoController"
      styleClass="pantalla" spacing="18">
    <padding><Insets top="22" right="28" bottom="22" left="28"/></padding>

    <VBox spacing="2">
        <Label text="Catálogo" styleClass="titulo-pantalla"/>
        <Label text="Ejemplares disponibles y prestados" styleClass="subtitulo-pantalla"/>
    </VBox>

    <VBox styleClass="tarjeta-tabla" VBox.vgrow="ALWAYS">
        <TableView fx:id="tablaLibros" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="columnaTitulo" text="TÍTULO"/>
                <TableColumn fx:id="columnaEdicion" text="EDICIÓN"/>
                <TableColumn fx:id="columnaEditorial" text="EDITORIAL"/>
                <TableColumn fx:id="columnaAnio" text="AÑO"/>
                <TableColumn fx:id="columnaDisponibilidad" text="ESTADO"/>
            </columns>
            <placeholder><Label text="No hay libros en el catálogo."/></placeholder>
        </TableView>
    </VBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="biblioteca.gui.LibrosController"
      spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>

    <children>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <Button text="Alta Libro" onAction="#altaLibro" styleClass="accent" />
                <Button fx:id="btnBaja" text="Dar de baja" onAction="#bajaLibro">
                    <tooltip><Tooltip text="Elimina el ejemplar seleccionado (la FK prestamo→libro impide borrar con historial)." /></tooltip>
                </Button>
            </children>
        </HBox>

        <TableView fx:id="tablaLibros" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colTitulo"    text="Título"    prefWidth="320" />
                <TableColumn fx:id="colEdicion"   text="Edición"   prefWidth="100" />
                <TableColumn fx:id="colEditorial" text="Editorial" prefWidth="220" />
                <TableColumn fx:id="colAnio"      text="Año"      prefWidth="100" />
                <TableColumn fx:id="colPrestado"  text="Prestado"  prefWidth="120" />
            </columns>
            <placeholder><Label text="No hay libros en el catálogo." /></placeholder>
        </TableView>

        <Label fx:id="msjEstado" />
    </children>
</VBox>

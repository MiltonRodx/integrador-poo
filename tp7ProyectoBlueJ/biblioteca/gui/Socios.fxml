<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableRow?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="biblioteca.gui.SociosController"
      spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>

    <children>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <Button text="Alta Docente"    onAction="#altaDocente"    styleClass="accent" />
                <Button text="Alta Estudiante" onAction="#altaEstudiante" />
                <Button fx:id="btnBaja" text="Dar de baja" onAction="#baja">
                    <tooltip><Tooltip text="Elimina el socio seleccionado (la FK prestamo→socio impide borrar quien tiene historial)." /></tooltip>
                </Button>
                <Button fx:id="btnPremiar" text="Premiar días" onAction="#premiar">
                    <tooltip><Tooltip text="Concede días extra de préstamo (premio de responsabilidad: solo docentes)." /></tooltip>
                </Button>
            </children>
        </HBox>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="campoBusqueda" promptText="Buscar socio: D.N.I., nombre o tipo" onAction="#buscarPorDni"
                           prefWidth="280" />
                <Button text="Buscar por D.N.I." onAction="#buscarPorDni" />
            </children>
        </HBox>

        <TableView fx:id="tablaSocios" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colDni"        text="D.N.I."   prefWidth="120" />
                <TableColumn fx:id="colNombre"     text="Nombre"   prefWidth="280" />
                <TableColumn fx:id="colTipo"       text="Tipo"     prefWidth="120" />
                <TableColumn fx:id="colPrestados"  text="Libros en poder" prefWidth="150" />
                <TableColumn fx:id="colDias"       text="Días de préstamo" prefWidth="160" />
            </columns>
            <placeholder><Label text="No hay socios dados de alta." /></placeholder>
        </TableView>

        <Label fx:id="msjEstado" />
    </children>
</VBox>

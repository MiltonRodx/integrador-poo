<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="biblioteca.gui.SociosController"
      spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>

    <children>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <Button text="Alta Docente"    onAction="#altaDocente" />
                <Button text="Alta Estudiante" onAction="#altaEstudiante" />
                <Button text="Baja"            onAction="#baja" />
                <Button text="Premiar dias"    onAction="#premiar" />
            </children>
        </HBox>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="campoBusqueda" promptText="D.N.I. a buscar" onAction="#buscarPorDni"
                           prefWidth="200" />
                <Button text="Buscar por D.N.I." onAction="#buscarPorDni" />
            </children>
        </HBox>

        <TableView fx:id="tablaSocios" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDni"        text="D.N.I."   prefWidth="120" />
                <TableColumn fx:id="colNombre"     text="Nombre"   prefWidth="280" />
                <TableColumn fx:id="colTipo"       text="Tipo"     prefWidth="120" />
                <TableColumn fx:id="colPrestados"  text="Libros en poder" prefWidth="150" />
                <TableColumn fx:id="colDias"       text="Dias de prestamo" prefWidth="160" />
            </columns>
            <placeholder><Label text="No hay socios dados de alta." /></placeholder>
        </TableView>
    </children>
</VBox>

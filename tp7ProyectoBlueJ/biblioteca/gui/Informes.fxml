<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="biblioteca.gui.InformesController"
      spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>

    <children>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <Button text="Formato 1: Socios"              onAction="#informeSocios" />
                <Button text="Formato 2: Libros"              onAction="#informeLibros" />
                <Button text="Titulos sin repetir"            onAction="#informeTitulos" />
                <Button text="Formato 3: Docentes Resp."      onAction="#informeResponsables" />
                <Button text="Prestamos vencidos"             onAction="#informeVencidos" />
            </children>
        </HBox>

        <HBox spacing="24" alignment="CENTER_LEFT">
            <children>
                <Label text="Estudiantes: " />
                <Label fx:id="lblEstudiantes" style="-fx-font-weight: bold;" />
                <Label text="Docentes: " />
                <Label fx:id="lblDocentes" style="-fx-font-weight: bold;" />
                <Label text="Vencidos: " />
                <Label fx:id="lblVencidos" style="-fx-font-weight: bold;" />
            </children>
        </HBox>

        <TextArea fx:id="areaInforme" editable="false" VBox.vgrow="ALWAYS"
                  promptText="Elija un informe de arriba: se muestra con los formatos exactos de la consigna." />
    </children>
</VBox>

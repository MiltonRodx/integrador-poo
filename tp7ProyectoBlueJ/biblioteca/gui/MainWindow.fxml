<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>

<TabPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         prefWidth="1024" prefHeight="640"
         tabClosingPolicy="UNAVAILABLE">
    <tabs>
        <Tab text="Socios" closable="false">
            <content>
                <fx:include source="Socios.fxml"/>
            </content>
        </Tab>
        <Tab text="Libros" closable="false">
            <content>
                <fx:include source="Libros.fxml"/>
            </content>
        </Tab>
        <Tab text="Préstamos" closable="false">
            <content>
                <fx:include source="Prestamos.fxml"/>
            </content>
        </Tab>
        <Tab text="Informes" closable="false">
            <content>
                <fx:include source="Informes.fxml"/>
            </content>
        </Tab>
    </tabs>
</TabPane>

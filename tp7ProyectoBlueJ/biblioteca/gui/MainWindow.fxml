<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<TabPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:id="tabPanePrincipal"
         prefWidth="1024" prefHeight="640"
         tabClosingPolicy="UNAVAILABLE">
    <tabs>
        <Tab text="Socios">
            <content>
                <VBox spacing="10">
                    <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>
                    <children>
                        <Label text="Socios">
                            <font><Font size="20" /></font>
                        </Label>
                        <Label text=" Alta docente/estudiante, busqueda por D.N.I., baja y premio de dias (FJ2)." />
                    </children>
                </VBox>
            </content>
        </Tab>
        <Tab text="Libros">
            <content>
                <VBox spacing="10">
                    <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>
                    <children>
                        <Label text="Libros">
                            <font><Font size="20" /></font>
                        </Label>
                        <Label text="Alta/baja de ejemplares, estado prestado si/no (FJ2)." />
                    </children>
                </VBox>
            </content>
        </Tab>
        <Tab text="Préstamos">
            <content>
                <VBox spacing="10">
                    <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>
                    <children>
                        <Label text="Préstamos">
                            <font><Font size="20" /></font>
                        </Label>
                        <Label text="Nuevo prestamo, devolucion, activos y vencidos (FJ2)." />
                    </children>
                </VBox>
            </content>
        </Tab>
        <Tab text="Informes">
            <content>
                <VBox spacing="10">
                    <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>
                    <children>
                        <Label text="Informes">
                            <font><Font size="20" /></font>
                        </Label>
                        <Label text="Listados de la consigna, contadores y docentes responsables (FJ2)." />
                    </children>
                </VBox>
            </content>
        </Tab>
    </tabs>
</TabPane>

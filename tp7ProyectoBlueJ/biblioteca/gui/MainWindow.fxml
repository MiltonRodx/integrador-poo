<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1024" prefHeight="640">
    <top>
        <HBox alignment="CENTER_RIGHT" styleClass="barra-tema">
            <padding>
                <Insets top="8" right="12" bottom="4" left="12"/>
            </padding>
            <Region HBox.hgrow="ALWAYS"/>
            <ToggleButton fx:id="toggleTema" styleClass="switch-tema" text="&#127769; Oscuro"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
    <tabs>
        <Tab text="Socios" closable="false">
            <content>
                <fx:include source="Socios.fxml"/>
            </content>
        </Tab>
        <Tab text="Libros" closable="false">
            <content>
                <fx:include source="Libros.fxml"/>
            </content>
        </Tab>
        <Tab text="Préstamos" closable="false">
            <content>
                <fx:include source="Prestamos.fxml"/>
            </content>
        </Tab>
        <Tab text="Informes" closable="false">
            <content>
                <fx:include source="Informes.fxml"/>
            </content>
        </Tab>
    </tabs>
        </TabPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="biblioteca.gui.PanelEstadisticasController"
      spacing="18" alignment="CENTER" minWidth="360" maxWidth="720">

    <padding><javafx.geometry.Insets top="18" right="18" bottom="18" left="18"/></padding>

    <!-- ===== Encabezado: titulo + fecha de referencia ===== -->
    <VBox alignment="CENTER" spacing="2">
        <Label text="Resumen de la Biblioteca" styleClass="titulo-panel"/>
        <Label fx:id="etiquetaFecha" text="estado al dia de hoy" styleClass="subtitulo-panel"/>
    </VBox>

    <!-- ===== Fila de 4 tarjetas: libros / socios / activos / vencidos ===== -->
    <HBox spacing="12" maxWidth="Infinity">
        <HBox styleClass="tarjeta-estadistica" spacing="12" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <StackPane styleClass="chip-estadistica, chip-azul" minWidth="46" minHeight="46" maxWidth="46" maxHeight="46">
                <Label text="&#128218;" styleClass="texto-icono"/>
            </StackPane>
            <VBox>
                <Label text="Libros" styleClass="titulo-estadistica"/>
                <Label fx:id="etiquetaLibros" styleClass="valor-estadistica"/>
                <Label fx:id="etiquetaLibrosDetalle" styleClass="detalle-estadistica" text=" " wrapText="true"/>
            </VBox>
        </HBox>

        <HBox styleClass="tarjeta-estadistica" spacing="12" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <StackPane styleClass="chip-estadistica, chip-verde" minWidth="46" minHeight="46" maxWidth="46" maxHeight="46">
                <Label text="&#128101;" styleClass="texto-icono"/>
            </StackPane>
            <VBox>
                <Label text="Socios" styleClass="titulo-estadistica"/>
                <Label fx:id="etiquetaSocios" styleClass="valor-estadistica"/>
                <Label fx:id="etiquetaSociosDetalle" styleClass="detalle-estadistica" text=" " wrapText="true"/>
            </VBox>
        </HBox>

        <HBox styleClass="tarjeta-estadistica" spacing="12" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <StackPane styleClass="chip-estadistica, chip-violeta" minWidth="46" minHeight="46" maxWidth="46" maxHeight="46">
                <Label text="&#128197;" styleClass="texto-icono"/>
            </StackPane>
            <VBox>
                <Label text="Activos" styleClass="titulo-estadistica"/>
                <Label fx:id="etiquetaActivos" styleClass="valor-estadistica"/>
                <Label fx:id="etiquetaActivosDetalle" styleClass="detalle-estadistica" text=" " wrapText="true"/>
            </VBox>
        </HBox>

        <HBox styleClass="tarjeta-estadistica" spacing="12" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <StackPane styleClass="chip-estadistica, chip-rojo" minWidth="46" minHeight="46" maxWidth="46" maxHeight="46">
                <Label text="&#9888;&#65039;" styleClass="texto-icono"/>
            </StackPane>
            <VBox>
                <Label text="Vencidos" styleClass="titulo-estadistica"/>
                <Label fx:id="etiquetaVencidos" styleClass="valor-estadistica"/>
                <Label fx:id="etiquetaVencidosDetalle" styleClass="detalle-estadistica" text=" " wrapText="true"/>
            </VBox>
        </HBox>
    </HBox>

    <!-- ===== Tarjeta del grafico: disponibles vs en prestamo ===== -->
    <HBox styleClass="tarjeta-estadistica" alignment="CENTER" spacing="28" maxWidth="Infinity">
        <VBox alignment="CENTER" spacing="6">
            <Label text="Catálogo" styleClass="titulo-seccion"/>
            <PieChart fx:id="graficoCatalogo" labelsVisible="false"
                      legendSide="BOTTOM" legendVisible="true"
                      prefWidth="270" prefHeight="210"/>
        </VBox>
        <VBox spacing="12" minWidth="190">
            <Label text="Detalle del catálogo" styleClass="titulo-seccion"/>
            <Label fx:id="etiquetaDisponibles" styleClass="fila-grafico"/>
            <Label fx:id="etiquetaEnPrestamo" styleClass="fila-grafico"/>
        </VBox>
    </HBox>
</VBox>
